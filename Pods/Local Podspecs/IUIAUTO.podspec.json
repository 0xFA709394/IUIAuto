{
  "name": "IUIAUTO",
  "version": "0.1.1",
  "summary": "IUIAuto — iOS UI 自动化 Agent（进程内触控合成，不依赖 XCUITest）",
  "description": "通过 WebSocket 长连接接收控制服务器下发的 JSON 指令，在宿主 App 进程内\n模拟 UI 操作（点击/双击/长按/滑动/捏合/文本输入/元素查询/截图/录制/性能采样）。\n不依赖 XCUITest/XCTest runner，非越狱真机可用（开发证书即可）。\n合成触控仅作用于宿主 App 进程内（iOS 沙箱限制）。",
  "homepage": "https://github.com/0xFA709394/IUIAuto",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "0xFA709394": "skyprayer@126.com"
  },
  "source": {
    "git": "https://github.com/0xFA709394/IUIAuto.git",
    "tag": "0.1.1"
  },
  "platforms": {
    "ios": "13.0"
  },
  "swift_versions": "5.0",
  "source_files": [
    "Sources/IUIAUTO.h",
    "Sources/Core/**/*.{h,m}",
    "Sources/Actions/**/*.{h,m}"
  ],
  "public_header_files": [
    "Sources/Core/IUAEngine.h",
    "Sources/Core/IUAConfiguration.h",
    "Sources/Core/IUALogger.h",
    "Sources/Core/IUACommandDispatcher.h",
    "Sources/Actions/IUATouchSynthesizer.h",
    "Sources/Actions/IUARecorder.h",
    "Sources/Actions/IUAPerfSampler.h",
    "Sources/IUIAUTO.h"
  ],
  "frameworks": [
    "UIKit",
    "QuartzCore",
    "Foundation"
  ],
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "NO",
    "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES",
    "CLANG_ENABLE_MODULES": "NO",
    "GCC_PREPROCESSOR_DEFINITIONS": "IUIAUTO_POD=1"
  },
  "user_target_xcconfig": {
    "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES",
    "GCC_PREPROCESSOR_DEFINITIONS": "IUIAUTO_POD=1"
  },
  "swift_version": "5.0"
}
